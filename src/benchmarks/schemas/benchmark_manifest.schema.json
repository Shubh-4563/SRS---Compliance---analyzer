{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shubh-4563/SRS---Compliance---analyzer/schemas/benchmark_manifest.schema.json",
  "title": "BenchmarkPairManifest",
  "description": "Declarative benchmark manifest schema for reference-guided SRS document compliance evaluation.",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "parent_requirements",
    "expected_document_compliance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "metadata": {
      "type": "object",
      "required": [
        "pair_id",
        "domain",
        "title",
        "description",
        "reference_document",
        "target_document",
        "tags"
      ],
      "properties": {
        "pair_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$"
        },
        "domain": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "reference_document": {
          "type": "object",
          "required": [
            "path",
            "filename",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "target_document": {
          "type": "object",
          "required": [
            "path",
            "filename",
            "sha256",
            "total_pages"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "total_pages": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parent_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "parent_id",
          "section_name",
          "topic_label",
          "description",
          "is_mandatory",
          "expected_compliance_status",
          "sub_requirements"
        ],
        "properties": {
          "parent_id": {
            "type": "string"
          },
          "section_name": {
            "type": "string"
          },
          "topic_label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "is_mandatory": {
            "type": "boolean"
          },
          "expected_compliance_status": {
            "type": "string",
            "enum": [
              "FULLY_COMPLIANT",
              "PARTIALLY_COMPLIANT",
              "NON_COMPLIANT",
              "NEEDS_REVIEW"
            ]
          },
          "sub_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sub_id",
                "claim_text",
                "expected_evidence_type",
                "is_mandatory",
                "decomposition_rationale",
                "ground_truth"
              ],
              "properties": {
                "sub_id": {
                  "type": "string"
                },
                "claim_text": {
                  "type": "string"
                },
                "expected_evidence_type": {
                  "type": "string",
                  "enum": [
                    "FACTUAL_STATEMENT",
                    "NUMERIC_TARGET",
                    "SAFETY_CONSTRAINT",
                    "INTERFACE_SPECIFICATION"
                  ]
                },
                "is_mandatory": {
                  "type": "boolean"
                },
                "decomposition_rationale": {
                  "type": "string"
                },
                "ground_truth": {
                  "type": "object",
                  "required": [
                    "retrieval",
                    "verification"
                  ],
                  "properties": {
                    "retrieval": {
                      "type": "object",
                      "required": [
                        "evidence_presence",
                        "expected_evidence"
                      ],
                      "properties": {
                        "evidence_presence": {
                          "type": "string",
                          "enum": [
                            "EXISTS",
                            "EXPLICIT_OMISSION",
                            "ABSENT"
                          ]
                        },
                        "expected_evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "block_id",
                              "page"
                            ],
                            "properties": {
                              "block_id": {
                                "type": "string"
                              },
                              "page": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "excerpt": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "verification": {
                      "type": "object",
                      "required": [
                        "expected_status",
                        "expected_rationale_notes"
                      ],
                      "properties": {
                        "expected_status": {
                          "type": "string",
                          "enum": [
                            "FULFILLED",
                            "EXPLICIT_OMISSION",
                            "CONTRADICTED",
                            "MISSING",
                            "NEEDS_REVIEW"
                          ]
                        },
                        "expected_rationale_notes": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "expected_document_compliance": {
      "type": "object",
      "required": [
        "verdict",
        "mandatory_coverage_pct",
        "optional_coverage_pct",
        "mandatory_fulfilled",
        "mandatory_total",
        "optional_fulfilled",
        "optional_total",
        "expected_status_counts"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "COMPLIANT",
            "NON_COMPLIANT",
            "CONDITIONALLY_COMPLIANT"
          ]
        },
        "mandatory_coverage_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "optional_coverage_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "mandatory_fulfilled": {
          "type": "integer",
          "minimum": 0
        },
        "mandatory_total": {
          "type": "integer",
          "minimum": 1
        },
        "optional_fulfilled": {
          "type": "integer",
          "minimum": 0
        },
        "optional_total": {
          "type": "integer",
          "minimum": 0
        },
        "expected_status_counts": {
          "type": "object",
          "required": [
            "FULFILLED",
            "EXPLICIT_OMISSION",
            "CONTRADICTED",
            "MISSING",
            "NEEDS_REVIEW"
          ],
          "properties": {
            "FULFILLED": {
              "type": "integer",
              "minimum": 0
            },
            "EXPLICIT_OMISSION": {
              "type": "integer",
              "minimum": 0
            },
            "CONTRADICTED": {
              "type": "integer",
              "minimum": 0
            },
            "MISSING": {
              "type": "integer",
              "minimum": 0
            },
            "NEEDS_REVIEW": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

